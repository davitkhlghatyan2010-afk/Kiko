generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  group
  solo
}

enum DayCredit {
  full
  none
}

enum SessionType {
  work
  rest
}

model Group {
  id          String   @id @default(uuid())
  name        String
  inviteCode  String   @unique @map("invite_code")
  adminUserId String   @unique @map("admin_user_id")
  admin       User     @relation("GroupAdmin", fields: [adminUserId], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  members     User[]   @relation("GroupMembers")

  @@map("groups")
}

model User {
  id                  String              @id @default(uuid())
  username            String              @unique
  email               String              @unique
  passwordHash        String              @map("password_hash")
  accountType         AccountType         @map("account_type")
  groupId             String?             @map("group_id")
  group               Group?              @relation("GroupMembers", fields: [groupId], references: [id])
  adminOfGroup        Group?              @relation("GroupAdmin")
  isAdmin             Boolean             @default(false) @map("is_admin")
  createdAt           DateTime            @default(now()) @map("created_at")
  // Nullable: accounts created before this field existed never saw a policy to
  // accept. Every new registration sets it -- enforced in routes/auth.js, not here.
  privacyAcceptedAt   DateTime?           @map("privacy_accepted_at")
  passwordResetTokens PasswordResetToken[]
  days                Day[]
  focusSessions       FocusSession[]
  recurringTasks      RecurringTask[]

  @@map("users")
}

// A template a user opts a task into repeating from. Declaring a new day
// snapshots each active one into a real Task row (text/amount copied at
// that moment) -- editing or deleting the template afterwards never rewrites
// already-declared days, only whether future days get it.
model RecurringTask {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  text      String
  amount    String
  createdAt DateTime @default(now()) @map("created_at")
  tasks     Task[]

  @@map("recurring_tasks")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("password_reset_tokens")
}

model Day {
  id         String     @id @default(uuid())
  userId     String     @map("user_id")
  user       User       @relation(fields: [userId], references: [id])
  date       DateTime   @db.Date
  deadlineAt DateTime   @map("deadline_at")
  declaredAt DateTime   @default(now()) @map("declared_at")
  startedAt  DateTime?  @map("started_at")
  credit     DayCredit?
  tasks      Task[]

  @@unique([userId, date])
  @@map("days")
}

model Task {
  id              String         @id @default(uuid())
  dayId           String         @map("day_id")
  day             Day            @relation(fields: [dayId], references: [id])
  text            String
  amount          String
  completed       Boolean        @default(false)
  createdAt       DateTime       @default(now()) @map("created_at")
  proof           Proof?
  // Nullable, SetNull on delete: which RecurringTask this was snapshotted
  // from, if any -- lets a single day's copy be removed (skip) or the
  // template stopped, without touching this row's own text/amount/history.
  recurringTaskId String?        @map("recurring_task_id")
  recurringTask   RecurringTask? @relation(fields: [recurringTaskId], references: [id], onDelete: SetNull)

  @@map("tasks")
}

model Proof {
  id         String   @id @default(uuid())
  taskId     String   @unique @map("task_id")
  task       Task     @relation(fields: [taskId], references: [id])
  summary    String
  aiQuestion String   @map("ai_question")
  userAnswer String?  @map("user_answer")
  flagged    Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("proofs")
}

// Write-only. Nothing in scoring/streak/deadline logic may read this table --
// it exists purely to log completed Pomodoro intervals for later analysis.
// Deliberately has no relation to Day/Task, so there is no schema-level path
// from scoring into session data.
model FocusSession {
  id        String      @id @default(uuid())
  userId    String      @map("user_id")
  user      User        @relation(fields: [userId], references: [id])
  date      DateTime    @db.Date
  startedAt DateTime    @map("started_at")
  endedAt   DateTime    @map("ended_at")
  type      SessionType

  @@map("sessions")
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  group
  solo
}

enum DayCredit {
  full
  none
}

model Group {
  id          String   @id @default(uuid())
  name        String
  inviteCode  String   @unique @map("invite_code")
  adminUserId String   @unique @map("admin_user_id")
  admin       User     @relation("GroupAdmin", fields: [adminUserId], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  members     User[]   @relation("GroupMembers")

  @@map("groups")
}

model User {
  id                  String              @id @default(uuid())
  username            String              @unique
  email               String              @unique
  passwordHash        String              @map("password_hash")
  accountType         AccountType         @map("account_type")
  groupId             String?             @map("group_id")
  group               Group?              @relation("GroupMembers", fields: [groupId], references: [id])
  adminOfGroup        Group?              @relation("GroupAdmin")
  isAdmin             Boolean             @default(false) @map("is_admin")
  createdAt           DateTime            @default(now()) @map("created_at")
  passwordResetTokens PasswordResetToken[]
  days                Day[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("password_reset_tokens")
}

model Day {
  id         String     @id @default(uuid())
  userId     String     @map("user_id")
  user       User       @relation(fields: [userId], references: [id])
  date       DateTime   @db.Date
  deadlineAt DateTime   @map("deadline_at")
  declaredAt DateTime   @default(now()) @map("declared_at")
  startedAt  DateTime?  @map("started_at")
  credit     DayCredit?
  tasks      Task[]

  @@unique([userId, date])
  @@map("days")
}

model Task {
  id        String   @id @default(uuid())
  dayId     String   @map("day_id")
  day       Day      @relation(fields: [dayId], references: [id])
  text      String
  amount    String
  completed Boolean  @default(false)
  proofId   String?  @map("proof_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("tasks")
}
